# ==============================================================================
# Issue Management Backend - Cloud Production Environment (Render, Neon, Upstash, Qdrant Cloud)
# ==============================================================================

# Active Spring Profile & Server Port
SPRING_PROFILES_ACTIVE=prod
# Render dynamically passes PORT (defaults to 8080 locally)
PORT=8080

# ==============================================================================
# 1. PostgreSQL Database (Neon Serverless PostgreSQL)
# ==============================================================================
# From Neon Dashboard -> Connection Details -> JDBC format:
# Example: jdbc:postgresql://ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://<your-neon-host>.neon.tech/<your-database>?sslmode=require
SPRING_DATASOURCE_USERNAME=your_neon_username
SPRING_DATASOURCE_PASSWORD=your_neon_password
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Neon-optimized HikariCP connection pool settings
DB_POOL_MAX=10
DB_POOL_MIN_IDLE=2
DB_POOL_IDLE_TIMEOUT=300000
DB_POOL_MAX_LIFETIME=600000
DB_POOL_CONNECTION_TIMEOUT=30000
DB_POOL_KEEPALIVE_TIME=120000

# ==============================================================================
# 2. Redis Cache & Conversation Memory (Upstash Redis)
# ==============================================================================
# Option A (Recommended): Direct Upstash Connection URL with TLS
# Example: rediss://default:AbCdEf123456@us1-example-32145.upstash.io:6379
REDIS_URL=rediss://default:<your-upstash-password>@<your-upstash-endpoint>.upstash.io:6379

# Option B: Individual fields (if REDIS_URL is not set)
REDIS_HOST=<your-upstash-endpoint>.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=your_upstash_password
REDIS_SSL_ENABLED=true
REDIS_TIMEOUT=5000ms

# ==============================================================================
# 3. Vector Database (Qdrant Cloud)
# ==========================================
# From Qdrant Cloud Console -> Clusters -> Cluster Details
# Host example: 8b123456-7890-abcd-ef01-23456789abcd.us-east4-0.gcp.cloud.qdrant.io
QDRANT_HOST=<your-cluster-id>.<region>.gcp.cloud.qdrant.io
QDRANT_PORT=6334
QDRANT_API_KEY=your_qdrant_cloud_api_key_here
QDRANT_USE_TLS=true
QDRANT_COLLECTION=issues

# ==============================================================================
# 4. Security & CORS (Vercel Frontend Integration)
# ==============================================================================
# Generate a cryptographically secure 256-bit hexadecimal string for JWT
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins: Add your Vercel deployment URL and preview domain pattern
# Example: https://issue-management.vercel.app,https://*.vercel.app,http://localhost:3000
CORS_ALLOWED_ORIGINS=https://<your-vercel-app>.vercel.app,https://*.vercel.app,http://localhost:3000,http://localhost:5173

# ==============================================================================
# 5. Google Gemini AI Integration
# ==============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_EMBEDDING_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# ==============================================================================
# 6. AI Assistant Memory & Semantic Cache
# ==============================================================================
ASSISTANT_MAX_MESSAGES=30
ASSISTANT_CONVERSATION_TTL_SECONDS=86400
ASSISTANT_MAX_USER_MESSAGE_LENGTH=4000
ASSISTANT_MAX_RETRIEVED_ITEMS=10
ASSISTANT_SEMANTIC_CACHE_ENABLED=true
ASSISTANT_SEMANTIC_CACHE_TTL_SECONDS=3600
ASSISTANT_SEMANTIC_CACHE_THRESHOLD=0.88
ASSISTANT_SEMANTIC_CACHE_MAX_CANDIDATES=20
